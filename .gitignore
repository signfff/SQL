# ---------------------------------------------------------------
# EGRAPH 实验产物：只保留源码与工具脚本，数据/构建/日志一律不入库
# ---------------------------------------------------------------
# Rust e-graph 服务的构建缓存（1.5 GB）
egraph-server/target/

# coverage/ 目录白名单：只收 PowerShell 工具脚本，
# 语料(GB 级)、gcov 数据、长跑输出目录、插桩构建全部排除
coverage/*
!coverage/sqlite/
coverage/sqlite/*
!coverage/sqlite/*.ps1
# 一次性的语料维护脚本也算工具脚本
!coverage/sqlite/compact-high-coverage-corpus.py
# 语料：官方派生链与 auto-research 过滤结果纳入版本控制（共约 30 MB）。
# high-coverage-egraph-corpus.sql 不入库 —— 它是从长跑的 replay 累积出来的，
# 单文件 1.8 GB 超过 GitHub 的 100 MB 硬限制，用 update-high-coverage-corpus.ps1 重建。
!coverage/sqlite/sqlite-official-test-corpus.sql
!coverage/sqlite/sqlite-official-select-only-corpus.sql
!coverage/sqlite/sqlite-official-select-only-variant-ready-corpus.sql
!coverage/sqlite/auto-research-filtered-corpus.sql

# 官方 bug 基准：收脚本、逐条判定、结构化提取记录和每个 bug 的小语料；
# 抓下来的论坛网页(28 MB)与每次实测的运行目录(数百 MB)不入库，用 run_case.py 重跑即可。
!coverage/sqlite/bugbench/
coverage/sqlite/bugbench/*
!coverage/sqlite/bugbench/*.py
!coverage/sqlite/bugbench/*.md
!coverage/sqlite/bugbench/*.json
!coverage/sqlite/bugbench/*.txt
!coverage/sqlite/bugbench/corpus/
!coverage/sqlite/bugbench/corpus/*.sql
!coverage/sqlite/bugbench/extract/
coverage/sqlite/bugbench/extract/*
!coverage/sqlite/bugbench/extract/*.jsonl

# 运行时日志与临时产物
logs/
trace.txt
egraph-*.log
egraph-*.txt
egraph-*.sql
run_egraph.*.log
run-monitor.ps1
cp_local.txt
META-INF/
*.db

# 个人文档与临时测试，不属于代码
*.pptx
*.docx
~$*
report1_text.txt
mytest.sql
论文/
egraph-server/server-*.txt
